<?xml version="1.0" encoding="utf-8"?>
<!-- Disallow cleartext traffic (MobSF / MASVS network hardening). Firebase & APIs use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
